<custom_udp>
  <float scale="1.0" channel="total_time" />
  <float scale="1.0" channel="paused" />
  <float scale="1.0" channel="vehicle_type" />
  <float scale="1.0" channel="position_x" />
  <float scale="1.0" channel="position_y" />
  <float scale="1.0" channel="position_z" />  
  <float scale="1.0" channel="world_dir_rht_x" /> <!--world space right direction-->
  <float scale="1.0" channel="world_dir_rht_y" />
  <float scale="1.0" channel="world_dir_rht_z" />
  <float scale="1.0" channel="world_dir_fwd_x" /> <!--world space forward direction-->
  <float scale="1.0" channel="world_dir_fwd_y" />
  <float scale="1.0" channel="world_dir_fwd_z" />  
  <float scale="1.0" channel="suspension_position_bl" />
  <float scale="1.0" channel="suspension_position_br" />
  <float scale="1.0" channel="suspension_position_fl" />
  <float scale="1.0" channel="suspension_position_fr" />
  <float scale="1.0" channel="suspension_velocity_bl" />
  <float scale="1.0" channel="suspension_velocity_br" />
  <float scale="1.0" channel="suspension_velocity_fl" />
  <float scale="1.0" channel="suspension_velocity_fr" />
  <float scale="1.0" channel="suspension_acceleration_bl" />
  <float scale="1.0" channel="suspension_acceleration_br" />
  <float scale="1.0" channel="suspension_acceleration_fl" />
  <float scale="1.0" channel="suspension_acceleration_fr" />
  <float scale="1.0" channel="wheel_patch_speed_bl" />
  <float scale="1.0" channel="wheel_patch_speed_br" />
  <float scale="1.0" channel="wheel_patch_speed_fl" />
  <float scale="1.0" channel="wheel_patch_speed_fr" />
  <float scale="1.0" channel="throttle_input" />
  <float scale="1.0" channel="steering_input" />
  <float scale="1.0" channel="brake_input" />
  <float scale="1.0" channel="clutch_input" />
  <float scale="1.0" channel="gear" />
  <float scale="1.0" channel="max_gears" />
  <float scale="1.0" channel="engine_rate" />
  <float scale="1.0" channel="max_rpm" />
  <float scale="1.0" channel="idle_rpm" />
  
</custom_udp>
